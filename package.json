{
  "name": "sap-user-tracker-frontend",
  "private": true,
  "version": "0.1.4",
  "description": "SAP User Tracker desktop application",
  "author": "SAP User Tracker",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.sapusertracker.desktop",
    "productName": "SAP User Tracker",
    "icon": "src/assets/cbl_icon.png",
    "directories": {
      "output": "release-0.1.4"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/SAPTrackerBackend-v2.exe",
        "to": "backend/SAPTrackerBackend-v2.exe"
      },
      {
        "from": "src/assets/cbl_icon.png",
        "to": "cbl_icon.png"
      }
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "artifactName": "SAP-User-Tracker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAP User Tracker"
    }
  }
}
